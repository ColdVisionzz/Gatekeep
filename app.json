{
  "expo": {
    "name": "Gatekeep",
    "slug": "gatekeep",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0C0C0E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gatekeep.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-image",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Gatekeep saves each recap to its own album in your photos.",
          "savePhotosPermission": "Gatekeep saves each recap to its own album in your photos.",
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Gatekeep uses the camera to take the photo for your daily recap.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      "expo-font",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C0C0E",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ]
    ]
  }
}
